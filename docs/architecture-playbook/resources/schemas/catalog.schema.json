{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minecraft-constructing-agents.local/schemas/resource-catalog-v1.json",
  "title": "Architecture Playbook ResourceCatalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "updated_at", "sources"],
  "properties": {
    "schema_version": { "const": 1 },
    "catalog_id": { "const": "architecture-playbook-resource-catalog" },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "title",
          "lifecycle_status",
          "profile_path",
          "assessment_path"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "lifecycle_status": {
            "enum": [
              "registered",
              "probing",
              "assessed",
              "approved-for-intake",
              "deferred",
              "rejected"
            ]
          },
          "profile_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^sources/[a-z0-9]+(?:-[a-z0-9]+)*/source\\.json$"
          },
          "assessment_path": {
            "type": ["string", "null"],
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^sources/[a-z0-9]+(?:-[a-z0-9]+)*/assessment\\.md$"
          }
        }
      }
    }
  }
}
