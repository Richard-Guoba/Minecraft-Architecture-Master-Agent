{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "camera_manifest_sha256": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
    "cohort_sha256": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
    "environment": {
      "additionalProperties": false,
      "properties": {
        "client_options_sha256": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
        "horizontal_fov_degrees": { "const": 70 },
        "minecraft_version": { "const": "1.21.9" },
        "resource_pack_ids": {
          "items": false,
          "maxItems": 1,
          "minItems": 1,
          "prefixItems": [{ "const": "vanilla" }],
          "type": "array"
        },
        "time_of_day": { "const": 6000 },
        "viewport": {
          "additionalProperties": false,
          "properties": {
            "aspect_ratio": { "const": "16:9" },
            "height_px": { "const": 1080 },
            "width_px": { "const": 1920 }
          },
          "required": ["width_px", "height_px", "aspect_ratio"],
          "type": "object"
        },
        "weather": { "const": "clear" },
        "world_identifier_sha256": { "pattern": "^[a-f0-9]{64}$", "type": "string" }
      },
      "required": [
        "minecraft_version",
        "client_options_sha256",
        "resource_pack_ids",
        "viewport",
        "horizontal_fov_degrees",
        "time_of_day",
        "weather",
        "world_identifier_sha256"
      ],
      "type": "object"
    },
    "images": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "build_function_sha256": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
          "camera": {
            "additionalProperties": false,
            "properties": {
              "orientation": {
                "additionalProperties": false,
                "properties": {
                  "pitch_degrees": { "pattern": "^-?(0|[1-9]\\d*)\\.\\d{6}$", "type": "string" },
                  "yaw_degrees": { "pattern": "^-?(0|[1-9]\\d*)\\.\\d{6}$", "type": "string" }
                },
                "required": ["pitch_degrees", "yaw_degrees"],
                "type": "object"
              },
              "position": {
                "additionalProperties": false,
                "properties": {
                  "x": { "pattern": "^-?(0|[1-9]\\d*)\\.\\d{6}$", "type": "string" },
                  "y": { "pattern": "^-?(0|[1-9]\\d*)\\.\\d{6}$", "type": "string" },
                  "z": { "pattern": "^-?(0|[1-9]\\d*)\\.\\d{6}$", "type": "string" }
                },
                "required": ["x", "y", "z"],
                "type": "object"
              },
              "view_id": {
                "enum": [
                  "front-south",
                  "side-east",
                  "quarter-southeast",
                  "quarter-southwest",
                  "roof-birdseye",
                  "entry-eye"
                ],
                "type": "string"
              }
            },
            "required": ["view_id", "position", "orientation"],
            "type": "object"
          },
          "image_sha256": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
          "screenshot_id": {
            "pattern": "^capture-[a-z0-9-]+-opaque$",
            "type": "string"
          },
          "solution_id": {
            "pattern": "^opaque-solution-[a-z0-9]+$",
            "type": "string"
          }
        },
        "required": ["screenshot_id", "solution_id", "camera", "build_function_sha256", "image_sha256"],
        "type": "object"
      },
      "maxItems": 24,
      "minItems": 24,
      "type": "array"
    },
    "protocol_version": { "const": "0.1.0" },
    "request_sha256": {
      "const": "a33917169403b2ea9402486040c87f291bc378a47e85443e71ed4b82cb4491d1"
    },
    "schema_version": { "const": 1 },
    "visual_settings_sha256": {
      "const": "3f06660be200990192a73615c5cfabe635d8254965158dd78eee81aa46bb0296"
    }
  },
  "required": [
    "schema_version",
    "protocol_version",
    "cohort_sha256",
    "camera_manifest_sha256",
    "request_sha256",
    "visual_settings_sha256",
    "environment",
    "images"
  ],
  "title": "P6 Capture Manifest",
  "type": "object"
}
