{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "choice": {
      "enum": [
        "left",
        "right",
        "tie"
      ],
      "type": "string"
    },
    "comparison_manifest_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "type": "string"
    },
    "pair_id": {
      "pattern": "^pair-\\d{2}$",
      "type": "string"
    },
    "protocol_version": {
      "const": "0.1.0"
    },
    "rationale": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason_tags": {
      "items": {
        "enum": [
          "massing",
          "hierarchy",
          "silhouette",
          "roof",
          "facade",
          "materials",
          "detail",
          "scene",
          "style-consistency",
          "capture-uncertainty"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "reviewer_kind": {
      "const": "human"
    },
    "schema_version": {
      "const": 1
    },
    "sealed_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "protocol_version",
    "comparison_manifest_hash",
    "pair_id",
    "choice",
    "confidence",
    "reason_tags",
    "rationale",
    "reviewer_kind",
    "sealed_at"
  ],
  "title": "P6 Preference Record",
  "type": "object"
}
