{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "blueprint_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "bounds": {
      "additionalProperties": false,
      "properties": {
        "max_x": {
          "type": "integer"
        },
        "max_y": {
          "type": "integer"
        },
        "max_z": {
          "type": "integer"
        },
        "min_x": {
          "type": "integer"
        },
        "min_y": {
          "type": "integer"
        },
        "min_z": {
          "type": "integer"
        }
      },
      "required": [
        "min_x",
        "min_y",
        "min_z",
        "max_x",
        "max_y",
        "max_z"
      ],
      "type": "object"
    },
    "build_function_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "main_entry": {
      "additionalProperties": false,
      "properties": {
        "center_x": {
          "pattern": "^-?(0|[1-9]\\d*)\\.\\d{6}$",
          "type": "string"
        },
        "center_y": {
          "pattern": "^-?(0|[1-9]\\d*)\\.\\d{6}$",
          "type": "string"
        },
        "center_z": {
          "pattern": "^-?(0|[1-9]\\d*)\\.\\d{6}$",
          "type": "string"
        },
        "facing": {
          "const": "south"
        }
      },
      "required": [
        "center_x",
        "center_y",
        "center_z",
        "facing"
      ],
      "type": "object"
    },
    "protocol_version": {
      "const": "0.1.0"
    },
    "request_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "settings_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "solution_id": {
      "enum": [
        "playbook-candidate-01",
        "playbook-candidate-02",
        "playbook-candidate-03",
        "baseline-current"
      ],
      "type": "string"
    },
    "views": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "entry_offset_blocks": {
            "const": 8
          },
          "horizontal_fov_degrees": {
            "const": 70
          },
          "position": {
            "additionalProperties": false,
            "properties": {
              "x": {
                "pattern": "^-?(0|[1-9]\\d*)\\.\\d{6}$",
                "type": "string"
              },
              "y": {
                "pattern": "^-?(0|[1-9]\\d*)\\.\\d{6}$",
                "type": "string"
              },
              "z": {
                "pattern": "^-?(0|[1-9]\\d*)\\.\\d{6}$",
                "type": "string"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "type": "object"
          },
          "purpose": {
            "enum": [
              "principal-facade-hierarchy",
              "side-facade-depth",
              "volume-attachment-roof-silhouette",
              "opposite-volume-relationship",
              "roof-composition-footprint",
              "approach-scale-entrance-legibility"
            ],
            "type": "string"
          },
          "target": {
            "additionalProperties": false,
            "properties": {
              "x": {
                "pattern": "^-?(0|[1-9]\\d*)\\.\\d{6}$",
                "type": "string"
              },
              "y": {
                "pattern": "^-?(0|[1-9]\\d*)\\.\\d{6}$",
                "type": "string"
              },
              "z": {
                "pattern": "^-?(0|[1-9]\\d*)\\.\\d{6}$",
                "type": "string"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "type": "object"
          },
          "view_id": {
            "enum": [
              "front-south",
              "side-east",
              "quarter-southeast",
              "quarter-southwest",
              "roof-birdseye",
              "entry-eye"
            ],
            "type": "string"
          }
        },
        "required": [
          "view_id",
          "purpose",
          "horizontal_fov_degrees",
          "position",
          "target"
        ],
        "type": "object"
      },
      "maxItems": 6,
      "minItems": 6,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "protocol_version",
    "solution_id",
    "blueprint_sha256",
    "build_function_sha256",
    "request_sha256",
    "settings_sha256",
    "bounds",
    "main_entry",
    "views"
  ],
  "title": "P6 Camera Manifest",
  "type": "object"
}
