{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "blueprint_sha256": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
    "bounds": {
      "additionalProperties": false,
      "properties": {
        "max_x": { "type": "integer" },
        "max_y": { "type": "integer" },
        "max_z": { "type": "integer" },
        "min_x": { "type": "integer" },
        "min_y": { "type": "integer" },
        "min_z": { "type": "integer" }
      },
      "required": ["min_x", "min_y", "min_z", "max_x", "max_y", "max_z"],
      "type": "object"
    },
    "build_function_sha256": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
    "main_entry": {
      "additionalProperties": false,
      "properties": {
        "center_x": { "pattern": "^-?(0|[1-9]\\d*)\\.\\d{6}$", "type": "string" },
        "center_y": { "pattern": "^-?(0|[1-9]\\d*)\\.\\d{6}$", "type": "string" },
        "center_z": { "pattern": "^-?(0|[1-9]\\d*)\\.\\d{6}$", "type": "string" },
        "facing": { "const": "south" }
      },
      "required": ["center_x", "center_y", "center_z", "facing"],
      "type": "object"
    },
    "protocol_version": { "const": "0.1.0" },
    "request_sha256": {
      "const": "c0d091dd4277b6f8c020ac788baf43487fee03bdf3dc9973f219ed92e02c2c5b"
    },
    "schema_version": { "const": 1 },
    "settings_sha256": {
      "const": "3f06660be200990192a73615c5cfabe635d8254965158dd78eee81aa46bb0296"
    },
    "solution_id": {
      "enum": [
        "playbook-candidate-01",
        "playbook-candidate-02",
        "playbook-candidate-03",
        "baseline-current"
      ],
      "type": "string"
    },
    "views": {
      "items": false,
      "maxItems": 6,
      "minItems": 6,
      "prefixItems": [
        {
          "additionalProperties": false,
          "properties": {
            "horizontal_fov_degrees": { "const": 70 },
            "position": { "$ref": "#/$defs/point" },
            "purpose": { "const": "principal-facade-hierarchy" },
            "target": { "$ref": "#/$defs/point" },
            "view_id": { "const": "front-south" }
          },
          "required": ["view_id", "purpose", "horizontal_fov_degrees", "position", "target"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "horizontal_fov_degrees": { "const": 70 },
            "position": { "$ref": "#/$defs/point" },
            "purpose": { "const": "side-facade-depth" },
            "target": { "$ref": "#/$defs/point" },
            "view_id": { "const": "side-east" }
          },
          "required": ["view_id", "purpose", "horizontal_fov_degrees", "position", "target"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "horizontal_fov_degrees": { "const": 70 },
            "position": { "$ref": "#/$defs/point" },
            "purpose": { "const": "volume-attachment-roof-silhouette" },
            "target": { "$ref": "#/$defs/point" },
            "view_id": { "const": "quarter-southeast" }
          },
          "required": ["view_id", "purpose", "horizontal_fov_degrees", "position", "target"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "horizontal_fov_degrees": { "const": 70 },
            "position": { "$ref": "#/$defs/point" },
            "purpose": { "const": "opposite-volume-relationship" },
            "target": { "$ref": "#/$defs/point" },
            "view_id": { "const": "quarter-southwest" }
          },
          "required": ["view_id", "purpose", "horizontal_fov_degrees", "position", "target"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "horizontal_fov_degrees": { "const": 70 },
            "position": { "$ref": "#/$defs/point" },
            "purpose": { "const": "roof-composition-footprint" },
            "target": { "$ref": "#/$defs/point" },
            "view_id": { "const": "roof-birdseye" }
          },
          "required": ["view_id", "purpose", "horizontal_fov_degrees", "position", "target"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "entry_offset_blocks": { "const": 8 },
            "horizontal_fov_degrees": { "const": 70 },
            "position": { "$ref": "#/$defs/point" },
            "purpose": { "const": "approach-scale-entrance-legibility" },
            "target": { "$ref": "#/$defs/point" },
            "view_id": { "const": "entry-eye" }
          },
          "required": ["view_id", "purpose", "horizontal_fov_degrees", "position", "target", "entry_offset_blocks"],
          "type": "object"
        }
      ],
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "protocol_version",
    "solution_id",
    "blueprint_sha256",
    "build_function_sha256",
    "request_sha256",
    "settings_sha256",
    "bounds",
    "main_entry",
    "views"
  ],
  "title": "P6 Camera Manifest",
  "type": "object",
  "$defs": {
    "point": {
      "additionalProperties": false,
      "properties": {
        "x": { "pattern": "^-?(0|[1-9]\\d*)\\.\\d{6}$", "type": "string" },
        "y": { "pattern": "^-?(0|[1-9]\\d*)\\.\\d{6}$", "type": "string" },
        "z": { "pattern": "^-?(0|[1-9]\\d*)\\.\\d{6}$", "type": "string" }
      },
      "required": ["x", "y", "z"],
      "type": "object"
    }
  }
}
