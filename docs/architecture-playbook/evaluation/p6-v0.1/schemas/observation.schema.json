{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capture_manifest_hash": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
    "criterion": {
      "enum": [
        "massing-hierarchy",
        "structural-legibility",
        "silhouette",
        "roof-composition",
        "facade-rhythm-depth",
        "material-role-legibility",
        "detail-density",
        "scene-integration",
        "style-consistency"
      ],
      "type": "string"
    },
    "design_layer": {
      "enum": [
        "massing",
        "structure",
        "roof",
        "facade",
        "materials",
        "scene"
      ],
      "type": "string"
    },
    "evidence_regions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "region": {
            "oneOf": [
              { "type": "null" },
              {
                "additionalProperties": false,
                "properties": {
                  "height": { "exclusiveMinimum": 0, "maximum": 1, "type": "number" },
                  "width": { "exclusiveMinimum": 0, "maximum": 1, "type": "number" },
                  "x": { "minimum": 0, "maximum": 1, "type": "number" },
                  "y": { "minimum": 0, "maximum": 1, "type": "number" }
                },
                "required": ["x", "y", "width", "height"],
                "type": "object"
              }
            ]
          },
          "region_kind": { "enum": ["whole-frame", "rect"], "type": "string" },
          "screenshot_id": {
            "pattern": "^capture-[a-z0-9-]+-opaque$",
            "type": "string"
          }
        },
        "if": {
          "properties": {
            "region_kind": { "const": "whole-frame" }
          },
          "required": ["region_kind"]
        },
        "required": ["screenshot_id", "region_kind", "region"],
        "else": {
          "properties": {
            "region": {
              "additionalProperties": false,
              "properties": {
                "height": { "exclusiveMinimum": 0, "maximum": 1, "type": "number" },
                "width": { "exclusiveMinimum": 0, "maximum": 1, "type": "number" },
                "x": { "minimum": 0, "maximum": 1, "type": "number" },
                "y": { "minimum": 0, "maximum": 1, "type": "number" }
              },
              "required": ["x", "y", "width", "height"],
              "type": "object"
            }
          }
        },
        "then": {
          "properties": {
            "region": { "type": "null" }
          }
        },
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "limitations": {
      "items": { "minLength": 1, "type": "string" },
      "maxItems": 8,
      "uniqueItems": true,
      "type": "array"
    },
    "observable_paraphrase": { "maxLength": 400, "minLength": 1, "type": "string" },
    "observation_id": { "pattern": "^observation-\\d{2,}$", "type": "string" },
    "protocol_version": { "const": "0.1.0" },
    "rating": { "enum": ["strong", "usable", "weak", "fail", "unknown"], "type": "string" },
    "reviewed_at": { "format": "date-time", "type": "string" },
    "reviewer_kind": { "enum": ["human", "model-assisted"], "type": "string" },
    "rule_ids": {
      "items": { "pattern": "^rule:[a-z0-9][a-z0-9.-]*$", "type": "string" },
      "uniqueItems": true,
      "type": "array"
    },
    "schema_version": { "const": 1 },
    "solution_authority_hash": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
    "view_ids": {
      "items": {
        "enum": [
          "front-south",
          "side-east",
          "quarter-southeast",
          "quarter-southwest",
          "roof-birdseye",
          "entry-eye"
        ],
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "protocol_version",
    "observation_id",
    "solution_authority_hash",
    "capture_manifest_hash",
    "view_ids",
    "design_layer",
    "criterion",
    "rating",
    "observable_paraphrase",
    "evidence_regions",
    "rule_ids",
    "limitations",
    "reviewer_kind",
    "reviewed_at"
  ],
  "title": "P6 Observation",
  "type": "object"
}
